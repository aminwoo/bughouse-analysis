+    if (!searchMoves.empty()) {
+        if (isBackground) {
+            std::cout << "info string searchmoves is not supported with go background" << std::endl;
+            ongoingSearch.store(false, std::memory_order_release);
+            return;
+        }
+        int restrictedBoard = -1;
+        std::vector<int> restrictedMoves;
+        for (const std::string& token : searchMoves) {
+            const int boardNum = token[0] - '1';
+            // Board B's colours are reversed: teamSide plays black there.
+            const bool onTurn = boardNum == BOARD_A
+                ? board.side_to_move(BOARD_A) == teamSide
+                : board.side_to_move(BOARD_B) == ~teamSide;
+            std::string moveStr = token.substr(1);
+            const Stockfish::Move move = onTurn
+                ? Stockfish::UCI::to_move(*board.pos[boardNum], moveStr)
+                : Stockfish::MOVE_NONE;
+            if (move == Stockfish::MOVE_NONE
+                || (restrictedBoard >= 0 && boardNum != restrictedBoard)) {
+                std::cout << "info string searchmoves: " << token
+                          << " is not a legal move for this team, or not on the same board"
+                          << std::endl;
+                std::cout << "bestmove (none)" << std::endl;
+                ongoingSearch.store(false, std::memory_order_release);
+                return;
+            }
+            restrictedBoard = boardNum;
+            restrictedMoves.push_back(static_cast<int>(move));
+        }
+        opts.search.rootMoveBoard = restrictedBoard;
+        opts.search.rootMoves = std::move(restrictedMoves);
+        // The root scans, the mate probe and the certification veto choose
+        // among all root actions on their own; leave the choice to the
+        // restricted tree.
+        opts.search.enableRootMateSearch = false;
+        opts.search.certifySelectedMove = false;
+    }
+    const bool restricted = !opts.search.rootMoves.empty();
+    if (restricted || lastSearchRestricted) {
+        agent->reset_search_state();
+    }
+    lastSearchRestricted = restricted;
